{# A labelled list of choices: `options={[ui.choice("a", "A")]}`. #}
{% props label: String, name: String, options: List<Choice>, selected: String = "", hint: String = "", error: String = "", required: Bool = false, disabled: Bool = false, id: String = "" %}
{% let field = field_id(id, name) %}
<div class="field">
  <label for={field}>{label}</label>
  {% if hint != "" %}<p class="hint" id="{field}-hint">{hint}</p>{% end %}
  <select id={field} name={name} required={required} disabled={disabled} aria-invalid={if error != "" { "true" } else { "false" }} aria-describedby={described_by(field, hint, error)}>
    {% for option in options %}
    <option value={option.value} selected={option.value == selected}>{option.label}</option>
    {% end %}
  </select>
  {% if error != "" %}<p class="error" id="{field}-error">{error}</p>{% end %}
</div>
<style>
.field { display: grid; gap: var(--space-xs, 0.25rem); margin-bottom: var(--space-md, 1rem); }
label { font-weight: 600; color: var(--color-text, #1f232b); }
.hint { margin: 0; font-size: 0.875rem; color: var(--color-muted, #4f5560); }
select {
  min-height: 2.75rem; padding: 0 var(--space-sm, 0.5rem);
  border: 1px solid var(--color-border, #8a8f98); border-radius: var(--radius-card, 0.5rem);
  font: inherit; background: var(--color-surface, #ffffff); color: var(--color-text, #1f232b);
}
select:focus-visible { outline: 3px solid var(--color-focus, #1f5fbf); outline-offset: 1px; }
.error { margin: 0; font-size: 0.875rem; color: var(--color-danger, #b3261e); font-weight: 600; }
</style>
