import sql, auth, web

// The database `DATABASE_URL` names. Opening it again, as a `server fn`
// does on each call, shares the same connections.
pub fn database() -> sql.Db ! {
    let url = env("DATABASE_URL") ?? "sqlite:journal.db"
    return try sql.open(url)
}

// Sessions kept in the database. Cookies are sent over HTTPS only,
// unless `JOURNAL_HTTP=1` says the program is served over plain HTTP, as
// it is on a laptop.
pub fn sessions(db: sql.Db) -> auth.Sessions ! {
    return try auth.sessions(db, secure: env("JOURNAL_HTTP") != "1")
}
