// Signing up, in and out.
import web, sql, orm, auth, validate, shared

pub fn routes(app: web.App, db: sql.Db, sessions: auth.Sessions) {
    app.get("/sign-up", fn(req) {
        return web.render("sign_up.glaze", { name: "", email: "", problems: [] })
    })

    app.post("/sign-up", fn(req) {
        let form = try req.form<{ name: String, email: String, password: String }>()
        let email = form.email.trim().lower()
        let taken = try orm.find<shared.User>(db).where(fn(u) { u.email == email }).count()
        let checked = validate.check([
            validate.required("name", form.name),
            validate.length("name", form.name, max: 80),
            validate.email("email", email),
            validate.when(taken > 0, "email", "someone has signed up with this email"),
            validate.length("password", form.password, min: 10, max: 200),
        ])
        if not checked.valid {
            var res = web.render("sign_up.glaze", { name: form.name, email: email, problems: checked.messages() })
            res.status = 422
            return res
        }
        // The person named by `JOURNAL_ADMIN` becomes an administrator.
        let role = if email == env("JOURNAL_ADMIN") { "admin" } else { "writer" }
        let hash = try auth.hash_password(form.password)
        let user = try orm.insert(db, shared.User(email: email, name: form.name.trim(), password: hash, role: role))
        return try sessions.sign_in(web.redirect("/"), "${user.id}", roles: [user.role])
    })

    app.get("/sign-in", fn(req) {
        return web.render("sign_in.glaze", { email: "", problem: "" })
    })

    app.post("/sign-in", fn(req) {
        let form = try req.form<{ email: String, password: String }>()
        let email = form.email.trim().lower()
        let found = try orm.find<shared.User>(db).where(fn(u) { u.email == email }).first()
        if found is some(user) and auth.verify_password(form.password, user.password) {
            // A new session each time: one an attacker planted before
            // signing in is left behind.
            return try sessions.sign_in(web.redirect("/"), "${user.id}", roles: [user.role])
        }
        // The same answer whether the email or the password was wrong.
        var res = web.render("sign_in.glaze", { email: email, problem: "That email and password do not match." })
        res.status = 401
        return res
    })

    app.post("/sign-out", fn(req) {
        let form = try req.form<{ csrf: String }>()
        try sessions.check(req, form.csrf)
        return try sessions.sign_out(req, web.redirect("/"))
    })
}
