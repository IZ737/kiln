    body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 40rem; color: #1F232B; background: #F7F3EC; }
    nav a { margin-right: 1rem; color: #C65A34; }
  </style>
</head>
<body>
  <nav><a href="/">Garden</a><a href="/about">About</a></nav>
  <main>{% slot %}</main>
</body>
</html>
