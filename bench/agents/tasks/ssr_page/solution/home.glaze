{% props products: List<shop.Product> %}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>Shop</title></head>
<body>
<h1>Shop</h1>
{% if products.is_empty() %}
<p>No products match.</p>
{% else %}
<table>
  <tr><th>Name</th><th>Price</th><th>Stock</th></tr>
  {% for p in products %}
  <tr><td>{p.name}</td><td>{shop.price(p.cents)}</td><td>{% if p.stock == 0 %}Sold out{% else %}{p.stock}{% end %}</td></tr>
  {% end %}
</table>
{% end %}
</body>
</html>
