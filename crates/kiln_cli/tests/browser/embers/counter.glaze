{% props name: String, start: Int = 0 %}
{% state count = start %}
<div class="counter" id={name}>
    <button class="inc" on:click={ count += 1 }>+1</button>
    <span class="count">{count}</span>
    <button class="add" on:click={ count = add(count, 10) catch err { -1 } }>+10 on the server</button>
</div>
