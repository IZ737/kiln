{% state message = "" %}
<form id="signup" method="post" action="/signup" on:submit={
    let form = event.form<Signup>() catch err { Signup(name: "", email: "") }
    message = signup(form) catch err { "Error: ${err.message}" }
}>
    <input name="name" required>
    <input name="email">
    <button>Sign up</button>
    <output>{message}</output>
</form>
