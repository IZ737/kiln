// Types and functions available in every file without an import.

struct Int {}
struct Float {}
struct Bool {}
struct String {}
struct Bytes {}
struct Decimal {}
struct Duration {}

// The default error type: a function declared with a bare `!` can fail with
// any error.
struct Error {
    message: String
}

struct Date {
    year: Int
    month: Int
    day: Int
}

struct List<T> {}
struct Map<K, V> {}
struct Set<T> {}

// A style: `ui({ p: space.md, bg: color.surface })`. See `ui` below and
// "Styles" in docs/reference/glazes.md.
struct Ui {}

fn print(value: Any) {}
// An environment variable, or none when it is not set.
fn env(name: String) -> String? {}
fn panic(message: String) -> Never {}

impl Int {
    fn to_string(self) -> String {}
    fn to_float(self) -> Float {}
    fn abs(self) -> Int {}
    fn min(self, other: Int) -> Int {}
    fn max(self, other: Int) -> Int {}
    fn pow(self, exp: Int) -> Int {}
    fn clamp(self, lo: Int, hi: Int) -> Int {}
}

impl Float {
    fn to_string(self) -> String {}
    fn round(self) -> Int {}
    fn floor(self) -> Int {}
    fn ceil(self) -> Int {}
    fn abs(self) -> Float {}
    fn sqrt(self) -> Float {}
    fn min(self, other: Float) -> Float {}
    fn max(self, other: Float) -> Float {}
    fn fixed(self, digits: Int) -> String {}
}

impl Duration {
    fn to_millis(self) -> Int {}
    fn to_seconds(self) -> Float {}
}

impl String {
    fn len(self) -> Int {}
    fn is_empty(self) -> Bool {}
    fn upper(self) -> String {}
    fn lower(self) -> String {}
    fn trim(self) -> String {}
    fn contains(self, part: String) -> Bool {}
    fn starts_with(self, prefix: String) -> Bool {}
    fn ends_with(self, suffix: String) -> Bool {}
    fn replace(self, from: String, to: String) -> String {}
    fn split(self, separator: String) -> List<String> {}
    fn to_int(self) -> Int? {}
    fn to_float(self) -> Float? {}
    fn index_of(self, part: String) -> Int? {}
    fn slice(self, start: Int, end: Int) -> String {}
    fn chars(self) -> List<String> {}
    fn lines(self) -> List<String> {}
    fn repeat(self, count: Int) -> String {}
    fn pad_start(self, width: Int, fill: String) -> String {}
    fn pad_end(self, width: Int, fill: String) -> String {}
    fn trim_start(self) -> String {}
    fn trim_end(self) -> String {}
}

impl List<T> {
    fn len(self) -> Int {}
    fn is_empty(self) -> Bool {}
    fn first(self) -> T? {}
    fn last(self) -> T? {}
    fn get(self, index: Int) -> T? {}
    fn push(self, item: T) {}
    fn contains(self, item: T) -> Bool {}
    fn filter(self, keep: fn(T) -> Bool) -> List<T> {}
    fn map<U>(self, transform: fn(T) -> U) -> List<U> {}
    fn find(self, matches: fn(T) -> Bool) -> T? {}
    fn any(self, matches: fn(T) -> Bool) -> Bool {}
    fn all(self, matches: fn(T) -> Bool) -> Bool {}
    fn sort_by<K>(self, key: fn(T) -> K) -> List<T> {}
    fn reverse(self) -> List<T> {}
    fn join(self, separator: String) -> String {}
    fn pop(self) -> T? {}
    fn insert(self, index: Int, item: T) {}
    fn remove_at(self, index: Int) -> T {}
    fn index_of(self, item: T) -> Int? {}
    fn slice(self, start: Int, end: Int) -> List<T> {}
    fn take(self, count: Int) -> List<T> {}
    fn skip(self, count: Int) -> List<T> {}
    fn concat(self, other: List<T>) -> List<T> {}
    fn sort(self) -> List<T> {}
    fn min(self) -> T? {}
    fn max(self) -> T? {}
    fn count(self, matches: fn(T) -> Bool) -> Int {}
    fn fold<A>(self, initial: A, combine: fn(A, T) -> A) -> A {}
    fn flat_map<U>(self, transform: fn(T) -> List<U>) -> List<U> {}
}

impl Map<K, V> {
    fn len(self) -> Int {}
    fn is_empty(self) -> Bool {}
    fn get(self, key: K) -> V? {}
    fn set(self, key: K, value: V) {}
    fn remove(self, key: K) -> V? {}
    fn contains(self, key: K) -> Bool {}
    fn keys(self) -> List<K> {}
    fn values(self) -> List<V> {}
    fn entries(self) -> List<{ key: K, value: V }> {}
}

impl Set<T> {
    fn len(self) -> Int {}
    fn is_empty(self) -> Bool {}
    fn add(self, item: T) {}
    fn remove(self, item: T) -> Bool {}
    fn contains(self, item: T) -> Bool {}
    fn to_list(self) -> List<T> {}
}
