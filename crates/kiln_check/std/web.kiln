// HTTP server, routing and responses.

// A web application: its routes, and the server that runs them.
struct App {}

// The runtime builds requests and reads responses as arrays of 8-byte slots
// in field order, so fields keep this order and these types.
struct Request {
    method: String
    // The path without the query string, as the client sent it.
    path: String
    // What follows `?` in the target, or "" when there is none.
    query_string: String
    // Header names are in lower case.
    headers: Map<String, String>
    body: String
}

struct Response {
    status: Int
    // Header names are written as they are here; the server adds
    // `content-length`, `date` and `connection`.
    headers: Map<String, String>
    body: String
}

// The settings have defaults, so `web.app()` is a production server:
// requests up to 16 MiB of body and 64 KiB of headers, 10 seconds for a
// client to send a request's head (and to keep sending its body and
// reading the response), kept-alive connections closed after 5 idle
// seconds (0s turns keep-alive off), a line on standard error per
// request, and 403 for a `POST`, `PUT`, `PATCH` or `DELETE` a browser
// sent from another site, except under the path prefixes in `cross_site`.
fn app(
    max_body: Int = 16_777_216,
    max_header: Int = 65_536,
    timeout: Duration = 10s,
    keep_alive: Duration = 5s,
    access_log: Bool = true,
    cross_site: List<String> = [],
) -> App {}

// An error the server answers with `status` (400 to 599) and `message`,
// which, unlike other errors' messages, is shown to the client:
// `throw web.error(404, "no post ${id}")`.
fn error(status: Int, message: String) -> Error {}
// Responses. `headers` are added to the ones each sets itself, such as
// `content-type`, and replace those with the same name.
fn render(
    template: String,
    data: Any = {},
    status: Int = 200,
    headers: Map<String, String> = Map(),
) -> Response {}
fn json(value: Any, status: Int = 200, headers: Map<String, String> = Map()) -> Response {}
fn text(body: String, status: Int = 200, headers: Map<String, String> = Map()) -> Response {}
fn html(body: String, status: Int = 200, headers: Map<String, String> = Map()) -> Response {}
// Binary data, such as an image or a download.
fn bytes(
    data: Bytes,
    content_type: String = "application/octet-stream",
    status: Int = 200,
    headers: Map<String, String> = Map(),
) -> Response {}
fn redirect(to: String, status: Int = 302, headers: Map<String, String> = Map()) -> Response {}
fn not_found() -> Response {}
// The request being handled, for a glaze's `request` prop.
fn __request() -> Request {}

// A route, as `app.get` and the other methods return it. `P` is what one
// of its pages is told by: `Unit` for a route without parameters, the
// parameter's type for a route with one (`Int` for `/posts/{id: Int}`), and
// a record for more (`{ dir: String, page: String }`).
struct Route<P> {}

// A handler takes the request, then one parameter per `{name}` in the route
// pattern. The type checker reads the pattern to type those parameters.
impl App {
    fn get<P>(self, path: String, handler: fn(Request, Rest) -> Response !) -> Route<P> {}
    fn post<P>(self, path: String, handler: fn(Request, Rest) -> Response !) -> Route<P> {}
    fn put<P>(self, path: String, handler: fn(Request, Rest) -> Response !) -> Route<P> {}
    fn patch<P>(self, path: String, handler: fn(Request, Rest) -> Response !) -> Route<P> {}
    fn delete<P>(self, path: String, handler: fn(Request, Rest) -> Response !) -> Route<P> {}
    // Makes the server's error responses: 404 and 405 when no route
    // matches, `web.not_found()`, errors handlers fail with, and requests
    // the server cannot read. It gets the request, the status and a
    // message: a `web.error`'s message, or else the status's reason, such
    // as "Not Found".
    fn on_error(self, handler: fn(Request, Int, String) -> Response) {}
    // Runs `hook` before the routes for every request whose path is
    // `prefix` or below it (`/admin` covers `/admin/users`). A hook that
    // returns a response answers the request, and one that fails answers
    // with the error, as a handler would; `none` lets the request go on to
    // the next hook and then its route. Hooks run in the order they were
    // added, so register them before anything they guard is reached.
    fn before(self, prefix: String, hook: fn(Request) -> Response? !) {}
    // Adds a route for each page in a project folder, here in the order
    // of routes: `pages/about.glaze` answers `GET /about`, `index.glaze`
    // its folder's URL and `[slug].glaze` `GET /{slug}`, and a
    // `route.kiln` beside a page gives it data (`pub fn load`), handlers
    // (`pub fn get`, `post`, ...) and static pages (`pub fn
    // static_params`). The routes are found when the program is compiled,
    // so `dir`, `at` (the URL they go under) and `ignore` (folder names
    // that hold components rather than pages) are written out.
    fn file_routes(self, dir: String, at: String = "/", ignore: List<String> = ["_components"]) {}
    fn listen(self, address: String) ! {}
}

// Static pages. `kiln fire --static` writes every `GET` route without
// parameters to a file, and the pages a route with parameters lists here:
// `app.get("/posts/{id: Int}", show).static(fn() { all_ids() })`. A
// running server renders a `.static` route's pages once, when it starts,
// and serves them from memory; with `refresh` it renders a page again on
// the first request after that long. `.dynamic()` leaves a `GET` route out
// of a static export.
impl Route<P> {
    // `pages` is left out for a route without parameters.
    fn static(self, pages: fn() -> List<P> ! = none, refresh: Duration? = none) -> Route<P> {}
    fn dynamic(self) -> Route<P> {}
}

// Where a browser sends a cookie from: `.Lax` (the default) keeps it off
// cross-site requests except top-level links, `.Strict` off all of them,
// and `.None` sends it everywhere, which needs `secure`.
enum SameSite {
    Lax
    Strict
    None
}

impl Response {
    // Adds a `set-cookie` header and returns the response. The value is
    // percent-encoded where a cookie cannot hold it, and `req.cookie`
    // decodes it. `max_age: 0s` deletes the cookie; without `max_age` it
    // lasts until the browser closes.
    fn set_cookie(
        self,
        name: String,
        value: String,
        max_age: Duration? = none,
        path: String = "/",
        same_site: SameSite = SameSite.Lax,
        http_only: Bool = true,
        secure: Bool = true,
    ) -> Response {}
}

impl Request {
    fn json<T>(self) -> T ! {}
    fn form<T>(self) -> T ! {}
    // The body as it came, for a body that need not be text.
    fn bytes(self) -> Bytes {}
    fn query(self, name: String) -> String? {}
    fn header(self, name: String) -> String? {}
    fn cookie(self, name: String) -> String? {}
}
