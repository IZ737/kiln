{
  "name": "kiln",
  "displayName": "Kiln",
  "description": "Kiln, Glaze and Ember language support: highlighting, file icons (kiln.toml and kiln.lock too), completion, hover, go to definition, and Check, Run, Build, Test, Dev and Format commands, from the Kiln language server.",
  "version": "0.15.0",
  "publisher": "iz737",
  "license": "MIT",
  "icon": "icons/kiln.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/IZ737/kiln",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/IZ737/kiln/tree/main/editors/vscode",
  "bugs": "https://github.com/IZ737/kiln/issues",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "kiln",
    "glaze",
    "web",
    "ember"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:kiln",
    "onLanguage:glaze",
    "workspaceContains:**/*.kiln",
    "onLanguage:ember"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kiln",
        "aliases": [
          "Kiln",
          "kiln"
        ],
        "extensions": [
          ".kiln"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kiln-source.svg",
          "dark": "./icons/kiln-source-dark.svg"
        }
      },
      {
        "id": "glaze",
        "aliases": [
          "Glaze",
          "glaze"
        ],
        "extensions": [
          ".glaze"
        ],
        "configuration": "./glaze-language-configuration.json",
        "icon": {
          "light": "./icons/glaze-component.svg",
          "dark": "./icons/glaze-component-dark.svg"
        }
      },
      {
        "id": "ember",
        "aliases": [
          "Ember",
          "ember"
        ],
        "extensions": [
          ".ember"
        ],
        "configuration": "./glaze-language-configuration.json",
        "icon": {
          "light": "./icons/ember-wasm.svg",
          "dark": "./icons/ember-wasm-dark.svg"
        }
      },
      {
        "id": "kiln-manifest",
        "aliases": [
          "Kiln manifest (TOML)"
        ],
        "filenames": [
          "kiln.toml"
        ],
        "configuration": "./toml-language-configuration.json",
        "icon": {
          "light": "./icons/kiln-manifest.svg",
          "dark": "./icons/kiln-manifest-dark.svg"
        }
      },
      {
        "id": "kiln-lock",
        "aliases": [
          "Kiln lockfile (TOML)"
        ],
        "filenames": [
          "kiln.lock"
        ],
        "configuration": "./toml-language-configuration.json",
        "icon": {
          "light": "./icons/kiln-lock.svg",
          "dark": "./icons/kiln-lock-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kiln",
        "scopeName": "source.kiln",
        "path": "./syntaxes/kiln.tmLanguage.json"
      },
      {
        "language": "glaze",
        "scopeName": "text.html.glaze",
        "path": "./syntaxes/glaze.tmLanguage.json",
        "embeddedLanguages": {
          "source.kiln": "kiln",
          "source.css": "css",
          "source.js": "javascript"
        }
      },
      {
        "language": "ember",
        "scopeName": "text.html.ember",
        "path": "./syntaxes/ember.tmLanguage.json",
        "embeddedLanguages": {
          "source.kiln": "kiln",
          "source.css": "css",
          "source.js": "javascript"
        }
      },
      {
        "language": "kiln-manifest",
        "scopeName": "source.toml.kiln",
        "path": "./syntaxes/toml.tmLanguage.json"
      },
      {
        "language": "kiln-lock",
        "scopeName": "source.toml.kiln",
        "path": "./syntaxes/toml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kiln.check",
        "title": "Check Program",
        "category": "Kiln",
        "icon": "$(check)"
      },
      {
        "command": "kiln.run",
        "title": "Run Program",
        "category": "Kiln",
        "icon": "$(play)"
      },
      {
        "command": "kiln.build",
        "title": "Build Program",
        "category": "Kiln",
        "icon": "$(package)"
      },
      {
        "command": "kiln.test",
        "title": "Test Program",
        "category": "Kiln",
        "icon": "$(beaker)"
      },
      {
        "command": "kiln.dev",
        "title": "Start Dev Server",
        "category": "Kiln",
        "icon": "$(server-process)"
      },
      {
        "command": "kiln.fmt",
        "title": "Format Program",
        "category": "Kiln"
      },
      {
        "command": "kiln.restartServer",
        "title": "Restart Language Server",
        "category": "Kiln"
      },
      {
        "command": "kiln.showOutput",
        "title": "Show Output",
        "category": "Kiln"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "kiln.run",
          "when": "resourceLangId == kiln",
          "group": "navigation@0"
        }
      ],
      "explorer/context": [
        {
          "command": "kiln.run",
          "when": "resourceExtname == .kiln",
          "group": "kiln@1"
        },
        {
          "command": "kiln.check",
          "when": "resourceExtname == .kiln || resourceExtname == .glaze",
          "group": "kiln@2"
        },
        {
          "command": "kiln.build",
          "when": "resourceExtname == .kiln",
          "group": "kiln@3"
        }
      ],
      "commandPalette": [
        {
          "command": "kiln.check",
          "when": "editorLangId == kiln || editorLangId == glaze || editorLangId == ember"
        },
        {
          "command": "kiln.run",
          "when": "editorLangId == kiln || editorLangId == glaze || editorLangId == ember"
        },
        {
          "command": "kiln.build",
          "when": "editorLangId == kiln || editorLangId == glaze || editorLangId == ember"
        },
        {
          "command": "kiln.test",
          "when": "editorLangId == kiln || editorLangId == glaze || editorLangId == ember"
        },
        {
          "command": "kiln.dev",
          "when": "editorLangId == kiln || editorLangId == glaze || editorLangId == ember"
        },
        {
          "command": "kiln.fmt",
          "when": "editorLangId == kiln || editorLangId == glaze || editorLangId == ember"
        }
      ]
    },
    "configuration": {
      "title": "Kiln",
      "properties": {
        "kiln.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `kiln` executable. Leave empty to use the one on your `PATH`, or else `~/.kiln/bin/kiln`, where the installers put it."
        },
        "kiln.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and kiln lsp in the Kiln output."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "kiln",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "check",
              "run",
              "build",
              "test",
              "dev",
              "fmt"
            ],
            "description": "The kiln command to run."
          },
          "program": {
            "type": "string",
            "description": "The program's folder, relative to the workspace folder. Defaults to the workspace folder."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "kiln",
        "owner": "kiln",
        "source": "kiln",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning)\\[(E\\d+)\\]: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*-->\\s+(.*):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "configurationDefaults": {
      "[kiln]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.insertMode": "replace"
      },
      "[glaze]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.suggest.insertMode": "replace"
      },
      "[ember]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.suggest.insertMode": "replace"
      }
    }
  },
  "scripts": {
    "bundle": "esbuild src/extension.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify",
    "vscode:prepublish": "npm run bundle",
    "test": "node --test test/*.test.js",
    "pretest:integration": "npm run bundle",
    "test:integration": "node test/integration/run.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.27.7",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
