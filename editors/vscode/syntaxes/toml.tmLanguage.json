{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TOML (kiln.toml, kiln.lock)",
  "scopeName": "source.toml.kiln",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#table"
    },
    {
      "include": "#entry"
    },
    {
      "include": "#invalid"
    }
  ],
  "repository": {
    "comment": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.toml",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.toml"
        }
      }
    },
    "table": {
      "patterns": [
        {
          "begin": "^\\s*(\\[\\[)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.array.table.toml"
            }
          },
          "end": "(\\]\\])",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.array.table.toml"
            }
          },
          "name": "meta.array.table.toml",
          "patterns": [
            {
              "include": "#table-key"
            }
          ]
        },
        {
          "begin": "^\\s*(\\[)(?!\\[)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.table.toml"
            }
          },
          "end": "(\\])",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.table.toml"
            }
          },
          "name": "meta.table.toml",
          "patterns": [
            {
              "include": "#table-key"
            }
          ]
        }
      ]
    },
    "table-key": {
      "patterns": [
        {
          "match": "[A-Za-z0-9_-]+",
          "name": "entity.name.section.toml"
        },
        {
          "include": "#quoted-key-section"
        },
        {
          "match": "\\.",
          "name": "punctuation.separator.dot.toml"
        }
      ]
    },
    "quoted-key-section": {
      "patterns": [
        {
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "name": "entity.name.section.toml"
        },
        {
          "match": "'[^']*'",
          "name": "entity.name.section.toml"
        }
      ]
    },
    "key": {
      "patterns": [
        {
          "match": "[A-Za-z0-9_-]+",
          "name": "variable.other.key.toml"
        },
        {
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"",
          "name": "variable.other.key.toml"
        },
        {
          "match": "'[^']*'",
          "name": "variable.other.key.toml"
        },
        {
          "match": "\\.",
          "name": "punctuation.separator.dot.toml"
        }
      ]
    },
    "entry": {
      "begin": "^\\s*((?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*'))*)\\s*(=)",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#key"
            }
          ]
        },
        "2": {
          "name": "punctuation.separator.key-value.toml"
        }
      },
      "end": "$",
      "name": "meta.entry.toml",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#datetime"
        },
        {
          "include": "#number"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.toml"
        },
        {
          "include": "#array"
        },
        {
          "include": "#inline-table"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"(?!\")",
          "name": "string.quoted.triple.basic.block.toml",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "begin": "'''",
          "end": "'''(?!')",
          "name": "string.quoted.triple.literal.block.toml"
        },
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.basic.line.toml",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'|$",
          "name": "string.quoted.single.literal.line.toml"
        }
      ]
    },
    "escape": {
      "patterns": [
        {
          "match": "\\\\([btnfr\"\\\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
          "name": "constant.character.escape.toml"
        },
        {
          "match": "\\\\\\s*$",
          "name": "constant.character.escape.toml"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.toml"
        }
      ]
    },
    "datetime": {
      "match": "\\b\\d{4}-\\d{2}-\\d{2}(?:[Tt ]\\d{2}:\\d{2}(?::\\d{2}(?:\\.\\d+)?)?(?:[Zz]|[+-]\\d{2}:\\d{2})?)?\\b|\\b\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?\\b",
      "name": "constant.other.time.toml"
    },
    "number": {
      "patterns": [
        {
          "match": "(?<![\\w.])[+-]?(?:inf|nan)\\b",
          "name": "constant.numeric.float.toml"
        },
        {
          "match": "(?<![\\w.])0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*\\b",
          "name": "constant.numeric.hex.toml"
        },
        {
          "match": "(?<![\\w.])0o[0-7](?:_?[0-7])*\\b",
          "name": "constant.numeric.octal.toml"
        },
        {
          "match": "(?<![\\w.])0b[01](?:_?[01])*\\b",
          "name": "constant.numeric.binary.toml"
        },
        {
          "match": "(?<![\\w.])[+-]?(?:0|[1-9](?:_?\\d)*)(?:\\.\\d(?:_?\\d)*)?(?:[eE][+-]?\\d(?:_?\\d)*)?\\b",
          "name": "constant.numeric.toml"
        }
      ]
    },
    "array": {
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.array.begin.toml"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.array.end.toml"
        }
      },
      "name": "meta.array.toml",
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.array.toml"
        },
        {
          "include": "#value"
        }
      ]
    },
    "inline-table": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.table.inline.begin.toml"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.table.inline.end.toml"
        }
      },
      "name": "meta.table.inline.toml",
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.table.inline.toml"
        },
        {
          "include": "#inline-entry"
        }
      ]
    },
    "inline-entry": {
      "patterns": [
        {
          "match": "((?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"(?:[^\"\\\\]|\\\\.)*\"|'[^']*'))*)\\s*(=)",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#key"
                }
              ]
            },
            "2": {
              "name": "punctuation.separator.key-value.toml"
            }
          }
        },
        {
          "include": "#value"
        }
      ]
    },
    "invalid": {
      "match": "\\S",
      "name": "invalid.illegal.toml"
    }
  }
}
