// The prelude's methods on numbers, strings, lists and maps.

struct Task {
    title: String
    hours: Float
}

fn main() {
    // Int and Float
    print(2.pow(10))
    print(15.clamp(0, 10))
    print((-2.5).abs())
    print(16.0.sqrt())
    print(1.5.min(0.5))
    print(1.5.max(0.5))
    print(3.14159.fixed(2))
    print(2.0.fixed(0))

    // String
    print("3.5".to_float())
    print("abc".to_float())
    print("héllo wörld".index_of("wörld"))
    print("hello".index_of("z"))
    print("héllo".slice(1, 3))
    print("hello".slice(3, 99))
    print("añb".chars())
    print("one\r\ntwo\nthree\n".lines())
    print("ab".repeat(3))
    print("7".pad_start(3, "0"))
    print("ab".pad_end(5, ".-"))
    print("[${"  x  ".trim_start()}]")
    print("[${"  x  ".trim_end()}]")

    // List
    var stack = [1, 2, 3]
    print(stack.pop())
    stack.insert(0, 9)
    stack.insert(3, 4)
    print(stack)
    print(stack.remove_at(1))
    print(stack)
    print(stack.index_of(4))
    print(stack.index_of(5))
    let nums = [5, 3, 8, 1, 9, 2]
    print(nums.slice(1, 4))
    print(nums.take(2))
    print(nums.skip(4))
    print(nums.take(0).concat([7]))
    print(nums.sort())
    print(["pear", "apple", "fig"].sort())
    print(nums.min())
    print(nums.max())
    let empty: List<Int> = []
    print(empty.max())
    print(nums.count(fn(n) { n > 4 }))
    print(nums.fold(0, fn(sum, n) { sum + n }))
    print(["a", "b"].fold("", fn(acc, s) { acc + s + s }))
    print([1, 2].flat_map(fn(n) { [n, n * 10] }))
    let tasks = [Task(title: "write", hours: 2.5), Task(title: "test", hours: 1.0)]
    let total = tasks.fold(0.0, fn(t, task) { t + task.hours })
    print("${total} hours")

    // Map
    let ages: Map<String, Int> = Map()
    ages["ada"] = 36
    ages["alan"] = 41
    for e in ages.entries() {
        print("${e.key} is ${e.value}")
    }
    print(ages.entries())
}
