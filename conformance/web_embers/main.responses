<!doctype html>
<html>
<head><title>Embers &lt;&amp;&gt;</title><script type="module" src="/_kiln/ember-HASH.js"></script></head>
<body>
<h1>Embers &lt;&amp;&gt;</h1>
<kiln-island data-k-ember="counter" data-k-hydrate="load" data-k-props="{&quot;label&quot;:&quot;Clicks&quot;,&quot;start&quot;:0}" data-k-state="{&quot;count&quot;:0,&quot;history&quot;:[]}"><div class="counter">
    <button>Clicks: 0</button>
    <button>Add 100</button>
    <ul>
    </ul>
</div></kiln-island>
<kiln-island data-k-ember="counter" data-k-hydrate="visible" data-k-props="{&quot;label&quot;:&quot;&lt;/script&gt;&lt;script&gt;alert(1)&lt;/script&gt;&quot;,&quot;start&quot;:10}" data-k-state="{&quot;count&quot;:10,&quot;history&quot;:[]}"><div class="counter">
    <button>&lt;/script&gt;&lt;script&gt;alert(1)&lt;/script&gt;: 10</button>
    <button>Add 100</button>
    <ul>
    </ul>
</div></kiln-island>
<kiln-island data-k-ember="panel" data-k-hydrate="idle" data-k-props="{&quot;heading&quot;:&quot;Later&quot;}" data-k-state="{&quot;open&quot;:true}"><section>
    <h2>Later</h2>
    <kiln-slot data-k-slot=""><p>Static text inside the panel.</p></kiln-slot>
</section></kiln-island>
<kiln-island data-k-ember="greeter" data-k-hydrate="only" data-k-props="{}" data-k-state="{&quot;name&quot;:&quot;&quot;,&quot;reply&quot;:&quot;&quot;}"></kiln-island>
</body>
</html>
