// Generic functions and methods: each use compiles a copy for its types,
// so generic code can show, compare and hash its values. Also type
// parameters in local annotations, generic values stored in optionals, and
// branches that end in `none`.
struct Task {
    id: Int
    title: String
    done: Bool = false
}

fn largest<T>(items: List<T>, key: fn(T) -> Int) -> T? {
    var best: T? = none
    var best_key = 0
    for item in items {
        if best == none or key(item) > best_key {
            best = item
            best_key = key(item)
        }
    }
    best
}

fn keep<T>(items: List<T>, ok: fn(T) -> Bool) -> List<T> {
    let out: List<T> = []
    let check = fn(x: T) -> Bool { ok(x) }
    for item in items where check(item) {
        out.push(item)
    }
    out
}

fn wrap<T>(value: T) -> T? {
    value
}

fn name(n: Int) -> String? {
    match n {
        1 => "one"
        2 => "two"
        _ => none
    }
}

struct Stack<T> {
    items: List<T>
}

impl Stack<T> {
    fn new() -> Stack<T> {
        Stack(items: [])
    }

    fn push(self, item: T) {
        self.items.push(item)
    }

    fn peek(self) -> T? {
        self.items.last()
    }

    fn describe(self) -> String {
        "stack of ${self.items.len()}: ${self.items}"
    }

    fn has(self, item: T) -> Bool {
        for x in self.items {
            if x == item {
                return true
            }
        }
        false
    }

    fn map<U>(self, f: fn(T) -> U) -> Stack<U> {
        Stack(items: self.items.map(f))
    }
}

fn describe<T>(label: String, value: T) -> String {
    "${label}: ${value}"
}

fn same<T>(a: T, b: T) -> Bool {
    a == b
}

fn count<T>(items: List<T>) -> Map<T, Int> {
    let counts: Map<T, Int> = Map()
    for item in items {
        counts[item] = (counts[item] ?? 0) + 1
    }
    counts
}

fn twice<T>(f: fn(T) -> T, x: T) -> T {
    f(f(x))
}

fn depth<T>(n: Int, value: T) -> String {
    if n == 0 {
        return describe("bottom", value)
    }
    depth(n - 1, value)
}

fn main() {
    let tasks = [Task(id: 1, title: "write"), Task(id: 3, title: "ship", done: true), Task(id: 2, title: "test")]
    print(largest(tasks, .id))
    print(largest(["a", "ccc", "bb"], fn(s) { s.len() }))
    print(largest([3, 9, 4], fn(n) { n }) ?? 0)
    print(largest([1.5, 2.5], fn(x) { x.round() }))
    print(largest([true], fn(b) { 1 }))
    let empty: List<Int> = []
    print(largest(empty, fn(n) { n }))

    print(keep(tasks, .done))
    print(keep([1, 2, 3, 4], fn(n) { n % 2 == 0 }))

    print(wrap(7))
    print(wrap("seven"))
    print(wrap(wrap(7.5)))

    print(name(1))
    print(name(9))
    let maybe = if tasks.len() > 5 { 5 } else { none }
    print(maybe ?? -1)

    print(describe("count", 3))
    print(describe("name", "Ada"))
    print(describe("task", Task(id: 1, title: "t")))
    print(describe("list", [1.5, 2.0]))
    print(describe("maybe", none ?? 4))
    print(same(1, 1))
    print(same("a", "b"))
    print(same(Task(id: 1, title: "t"), Task(id: 1, title: "t")))
    print(count(["a", "b", "a"]))
    print(count([3, 3, 3]))
    print(twice(fn(n) { n * 3 }, 2))
    print(twice(fn(s) { s + "!" }, "hi"))
    let f: fn(String, Int) -> String = describe
    print(f("via value", 9))
    print(depth(3, true))

    let s: Stack<Int> = Stack.new()
    s.push(1)
    s.push(2)
    print(s.describe())
    print(s.peek())
    print(s.has(2))
    print(s.has(5))
    let names = s.map(fn(n) { "#${n}" })
    print(names.describe())
    print(names.has("#1"))
}
